# ==============================================================================
#                      KAYRA ENGINE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and fill in your custom parameters and API keys.
# Do not commit your final '.env' file containing active credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SPEECH MATRIX CONFIGURATION (STT / TTS)
# ------------------------------------------------------------------------------
# Input language code for Speech-to-Text (e.g., hi-IN, en-US)
INPUT_LANGUAGE=hi-IN

# Voice model for Text-to-Speech engine (e.g., am_adam, af_bella)
ASSISTANT_VOICE=am_adam

# Where the Kokoro ONNX speech model runs.
#
#   AUTO   (default) Use CUDA when it genuinely initializes; CPU otherwise.
#   GPU    Require CUDA. If it cannot initialize, Kayra falls back to the CPU and says so -
#          in the boot log, in Settings, and in the device report. It never displays "GPU"
#          while the session is actually on the CPU.
#   CPU    Force the CPU. No GPU provider is passed to the session at all.
#
# HAVING A GPU IS NOT ENOUGH, AND NEITHER IS HAVING THE GPU PACKAGE. Four separate things must
# all be true:
#
#   1. GPU hardware exists
#   2. `onnxruntime-gpu` is installed (the plain `onnxruntime` wheel can never use CUDA)
#   3. the CUDA/cuDNN runtime it was BUILT against is installed AND loadable
#   4. a session actually initializes on it
#
# Step 3 is the one that bites. `onnxruntime-gpu` reports CUDAExecutionProvider the moment it
# is installed, whether or not the CUDA runtime is present - and when it is missing, ONNX
# Runtime does not raise. It logs "cublasLt64_12.dll is missing", drops the provider, and
# hands back a working CPU session.
#
# `python setup.py` handles all of it: it installs onnxruntime-gpu on NVIDIA machines, adds the
# matching NVIDIA CUDA/cuDNN runtime wheels, removes conflicting ONNX Runtime variants, and
# then PROVES a CUDA session can be created before reporting GPU readiness. Run it rather than
# installing ONNX Runtime by hand.
#
# WORTH KNOWING BEFORE YOU CHOOSE GPU: measured on an RTX 4060 Laptop with the full-precision
# kokoro.onnx, CUDA is NOT faster than the CPU for this model - RTF 0.93 on CUDA against 0.89
# on CPU - and it costs about 600 MB more RAM and 180 MiB of VRAM. ONNX Runtime reports "547
# Memcpy nodes added to the graph", i.e. the graph has many operators the CUDA provider does
# not implement and it round-trips between host and device throughout. GPU mode is correct and
# supported; it is simply not a speed-up for Kokoro on this hardware. CPU is a perfectly good
# choice here.
#
# ON A MACHINE WITHOUT AN NVIDIA GPU there is nothing to choose. Kayra's only acceleration
# path is CUDA, so AUTO and GPU both resolve to the processor and say so; setup installs no
# NVIDIA package of any kind, never launches nvidia-smi, and reports CUDA as NOT APPLICABLE
# rather than as a failed check. Nothing is wrong with that machine and nothing needs fixing.
TTS_DEVICE_MODE=AUTO

# ── Utterance endpointing: when has the user finished speaking? ────────
# THE ONE COMMIT POINT. `src/kayra/core/endpointing.py` owns these and the recognition page is
# configured FROM them, so there is never a second set baked into the JavaScript. Every value
# is range-clamped and the invariants (a fast path cannot exceed the baseline) are corrected
# rather than obeyed, so a typo degrades to the measured defaults instead of producing an
# endpointer that never fires.
#
# You are unlikely to need any of these. They exist because a quiet office and a noisy room
# genuinely need different hangovers, and the alternative to a setting is a user with no way to
# fix a recognizer that keeps cutting them off.

# How long the recognizer must produce nothing before the turn may end.
STT_SILENCE_MS=800

# A SHORT, ALREADY-COMMITTED command endpoints sooner — "stop" must not cost 800ms. Reachable
# only when nothing suggests the user is still going. Never longer than STT_SILENCE_MS.
STT_FAST_ENDPOINT_MS=420

# Words the recognizer has not committed yet are worth waiting for. Cutting here is how a
# spoken word becomes no word at all.
STT_INTERIM_GRACE_MS=1400

# How long the ROOM must be quiet, in energy terms, on top of the recognizer going quiet.
# This is what stops a mid-sentence breath ending the utterance. RAISE THIS if Kayra keeps
# cutting you off mid-sentence.
STT_VAD_HANGOVER_MS=500

# A turn younger than this cannot end, whatever the transcript says.
STT_MIN_UTTERANCE_MS=350

# Past this much speech, a one- or two-word transcript means the recognizer is BEHIND rather
# than that you said one word. Such a turn never takes the fast path and waits out a longer
# room hangover. It DELAYS a commit, it never blocks one — nothing is invented and no word is
# rejected.
STT_CONTINUATION_SPEECH_MS=1500

# Results keep arriving but the endpoint never settles: flush rather than accumulate a
# paragraph. Never fires while the VAD still hears you.
STT_MAX_UTTERANCE_WAIT_MS=6000

# The last-resort bound, so a wedged detector cannot make Kayra permanently deaf.
STT_ABSOLUTE_MAX_MS=30000

# ── Voice-activity hysteresis ──────────────────────────────────────────
# Speech is not a plateau: every stop consonant dips the energy below any single threshold. A
# bare comparator toggled "the user is speaking" several times a SECOND inside one sentence,
# which is what made the assistant visual flicker per syllable. Leaving the speaking state
# requires falling to STT_VAD_RELEASE_RATIO of the enter threshold AND staying there for
# STT_VAD_RELEASE_MS. Both halves are needed.
STT_VAD_RELEASE_RATIO=0.6
STT_VAD_RELEASE_MS=220

# ── Dangerous voice control ────────────────────────────────────────────
# Shutting Kayra down and putting it into standby ASK FIRST. A single recognition never
# executes either — the input is a probabilistic transcript of a room, and the cost of being
# wrong once is the whole session. "stop listening" is deliberately NOT gated: it closes the
# microphone, it is one button to undo, and a user who says it wants it now.
#
# How long an unanswered confirmation stays open. A late "yes" after this does nothing.
KAYRA_CONFIRMATION_TTL_SECONDS=20

# ── Local model: empty-response retries ────────────────────────────────
# The DMM retries an EMPTY completion (the model answered, and the answer contained no usable
# token) up to five times. This is not a transport retry — rate limits, timeouts and auth
# failures belong to the provider router and never reach it, so a rate-limited cloud key still
# costs exactly one call per provider per request.
#
# Five rather than three because the LOCAL path is where empty completions actually happen. The
# wall-clock budget is the other half: measured against LM Studio here an empty completion
# costs ~2.0s, so five retries is ~10s of silence — fine, but a slower backend must not turn
# that into half a minute. Whichever limit is reached first wins. There is no sleep between
# attempts and there must not be one.
KAYRA_DMM_RETRY_BUDGET_SECONDS=15

# ── Dangerous system actions: Kayra is not the computer ────────────────
# "Shut down" names two different operations, and Kayra keeps them completely apart.
#
#   "shut down Kayra" / "shut down the engine" / "exit"  -> ends the ASSISTANT, after asking
#   "shut down the computer" / "turn off my PC"          -> ends the WINDOWS SESSION, after
#                                                            asking, and only when the
#                                                            sentence NAMES a computer
#
# A power request that names neither is answered with a question, never with an action.
# There is deliberately no setting that relaxes this: the failure it prevents is a malformed
# transcript ("Shutdown the engine car.") ending the user's session, and a knob that could
# turn it off would be the same defect with an extra step.

# ── The local model's health cooldown ──────────────────────────────────
# A local model that answers nothing for three consecutive REQUESTS is not having a bad
# sample, it is not working. Running five retries per utterance against it costs ten seconds
# a turn and cannot succeed, so it stands down briefly and requests take the fallback. The
# first request after the cooldown IS the probe; one success clears it.
#
# These are compiled-in rather than configurable, because they are a bound on a failure mode
# rather than a preference: DMM_UNHEALTHY_AFTER = 3 requests,
# DMM_HEALTH_COOLDOWN_SECONDS = 20, DMM_RETRY_DELAY_MS = 120 (0 on the first retry, capped at
# 600). See `src/kayra/intelligence/llm_engine.py`.

# Which browser runs speech recognition. Kayra drives a HEADLESS, invisible browser session
# for voice input; it never opens or touches the browser you actually use.
#
#   auto      (default) Use the browser verified to work, preferring your Windows default.
#   chrome    Google Chrome
#   edge      Microsoft Edge  - preinstalled on Windows 11, so Chrome is NOT required
#   brave / chromium / opera / vivaldi
#
# IMPORTANT: not every Chromium browser can transcribe. The Web Speech API needs a speech
# BACKEND, and browsers ship different ones: Chrome uses Google's, Edge uses Microsoft's, and
# Brave deliberately ships neither (a privacy decision). In a backendless browser the API
# still exists and start() still succeeds - it simply never returns a transcript.
#
# Kayra therefore VERIFIES recognition before using a browser, and falls back to one that
# works, telling you when it does. Setting this to a browser without a backend will not make
# voice input work there; it will just be tried first and rejected.
#
# THIS SETTING IS LIVE. Changing it in Settings > Speech input switches the RUNNING session:
# the old browser is stopped, the requested one is started and verified, and only then is the
# change committed and written here. No restart is needed. This value is the backend Kayra
# starts with.
#
#   auto      picks a browser that can actually transcribe, exactly as it always has
#   a name    uses THAT browser, strictly. If it cannot start, Kayra says so, keeps the
#             backend it already had, and does NOT quietly substitute another one — the
#             Settings screen then shows Backend and Active as different values.
STT_BROWSER=auto


# ------------------------------------------------------------------------------
# SPEECH CAPTURE PIPELINE (src/kayra/input/speech_to_text.py)
# ------------------------------------------------------------------------------
# The recognition page runs a four-stage pipeline before a word ever reaches Python:
#
#   audio capture -> echo cancellation / noise suppression -> VAD / endpointing -> recognition
#
# and a fifth stage, conservative context-aware repair, runs in Python afterwards
# (src/kayra/input/transcript_repair.py).
#
# Kayra REPORTS what the microphone actually granted at startup rather than assuming it.
# Constraints are a request: if the line says echo cancellation was not granted, that is the
# real explanation for transcripts going wrong while Kayra is speaking, and no amount of
# tuning below will substitute for it.
#
# You should not normally need to change any of this. The two worth touching are the
# hangover (if Kayra cuts you off mid-sentence) and the VAD margin (if it never stops
# listening in a noisy room).

# How long the ROOM must be quiet, on top of the recognizer going quiet, before an utterance
# is considered finished. Raise it if Kayra ends your sentence early; lower it if short
# commands feel sluggish. This is the single most useful knob here.
STT_VAD_HANGOVER_MS=500

# A short command the recognizer has already committed to does not need the full silence
# window - "stop" should not cost 800ms.
STT_FAST_ENDPOINT_MS=420

# ...and words the recognizer has NOT committed to yet are worth waiting for. Cutting the
# utterance at that moment is how a word you clearly said becomes no word at all.
STT_INTERIM_GRACE_MS=1400

# Nothing waits forever. If results keep arriving but the endpoint never settles, flush.
STT_MAX_UTTERANCE_WAIT_MS=6000

# Voice is energy above this multiple of the LEARNED noise floor (the floor adapts to your
# room; this is how far above it counts as speech). Raise it in a noisy room.
STT_VAD_MARGIN=3.2

# The same, but while KAYRA IS SPEAKING. Higher on purpose: whatever echo of her own voice
# survives cancellation must not be able to hold your utterance open or start a new one.
STT_VAD_ECHO_MARGIN=7.0

# An absolute floor, so a perfectly silent input device cannot drive the threshold to zero.
STT_VAD_FLOOR_MIN=0.004

# How often the energy is sampled, in the page. 50ms is 20 samples a second and costs
# nothing measurable.
STT_VAD_INTERVAL_MS=50

# How many readings to ask the recognizer for. This is what lets the repair stage prefer a
# reading the recognizer ITSELF offered instead of inventing one, so 1 effectively disables
# the safest half of that stage.
STT_MAX_ALTERNATIVES=5


# ------------------------------------------------------------------------------
# OFFLINE / LOCAL ENGINE SETTINGS (LM Studio, Ollama, etc.)
# ------------------------------------------------------------------------------
# Set to 'True' to bypass checking for a local server and force Cloud APIs
FORCE_ONLINE=False

# Base URL pointing to your running offline local LLM server
LOCAL_BASE_URL=http://localhost:1234/v1

# Target model identifiers loaded on your local server
LOCAL_CHAT_MODEL=local-model
LOCAL_DECISION_MODEL=local-model

# API Key for local server (defaults to 'lm-studio')
LOCAL_API_KEY=lm-studio

# Per-address TCP connect budget for the "is a local model server running?" probe, in seconds.
# A server that IS listening accepts a loopback connection in well under a millisecond, so the
# default is deliberately tight — it is paid once per address family at every startup.
LOCAL_PROBE_TIMEOUT_SECONDS=0.15


# ------------------------------------------------------------------------------
# CLOUD APIs CONFIGURATION (Used if FORCE_ONLINE=True or local server is down)
# ------------------------------------------------------------------------------
# Cloud API Credentials (leave blank any key you don't have)
#
# THE PROVIDER HIERARCHY. There are TWO of them, and they are deliberately different:
#
#     DECISION (the DMM, intent classification)    Cohere  ->  Groq  ->  Gemini
#     CHAT     (conversation, search, research)    Groq    ->  Gemini
#
# Cohere leads DECISION because the DMM's few-shot token contract was written and measured
# against Command-R; it is not a chat provider here and never leads CHAT. Groq leads CHAT
# because it produces the fastest first token, and is the DMM's first fallback rather than its
# primary because the intent-boundary matrix was tuned against Cohere.
#
# A provider you have no key for is skipped silently. With no Cohere key the DMM starts at
# Groq; with no Groq key chat starts at Gemini; with nothing configured Kayra says so.
#
# WHAT HAPPENS WHEN ONE FAILS. The failure is classified once (RATE_LIMITED, AUTH_FAILURE,
# NETWORK_FAILURE, TIMEOUT, SERVER_ERROR, INVALID_REQUEST, MODEL_UNAVAILABLE, UNKNOWN), the
# provider is stood down for a bounded cooldown, and the request goes STRAIGHT to the next
# provider in the chain — sequentially, never all at once, and at most once per provider per
# request. There is no blocking backoff: a rate-limited Cohere is answered by Groq in about
# 700ms, and the NEXT request skips Cohere entirely until its cooldown expires.
CohereAPIKey=your_cohere_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_your_free_groq_key_here


# Cloud model identifiers
COHERE_DECISION_MODEL=command-r-plus-08-2024
# Must be a model your Groq account can actually serve. Check with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# An invalid id here is not fatal (the engine falls back to Gemini) but it costs a failed
# request on every single turn before the fallback happens.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_CHAT_MODEL=gemini-2.5-flash


# ------------------------------------------------------------------------------
# PROVIDER FAILOVER (src/kayra/intelligence/provider_router.py)
# ------------------------------------------------------------------------------
# How long a provider is skipped after each kind of failure, in seconds.
#
# These are BOUNDS, not behaviour switches. There is deliberately no setting that turns
# fallback off, reorders the hierarchy or disables the cooldown — the same rule the automation
# knobs follow. Every value is clamped to 0..86400, so a malformed entry cannot stand a
# provider down for a week or disable the policy.
#
# A provider that supplies its own `Retry-After` header ALWAYS wins over the value here: it is
# the only number that reflects what that key's budget is actually doing. Measured live: Groq
# returned Retry-After 6 under load and was skipped for 6s rather than the 60s default.

# A rate limit is temporary and the provider is otherwise healthy, so this is short.
PROVIDER_COOLDOWN_RATE_LIMIT_SECONDS=60

# A wrong or missing key does not fix itself. Retrying it every turn is the retry storm the
# router exists to prevent, so this is long.
PROVIDER_COOLDOWN_AUTH_SECONDS=900

PROVIDER_COOLDOWN_NETWORK_SECONDS=30
PROVIDER_COOLDOWN_TIMEOUT_SECONDS=30
PROVIDER_COOLDOWN_SERVER_ERROR_SECONDS=60
PROVIDER_COOLDOWN_MODEL_SECONDS=300

# The bucket for failures that have not been classified. Deliberately short: standing a
# provider down for minutes over a mystery is worse than trying it again shortly.
PROVIDER_COOLDOWN_UNKNOWN_SECONDS=20

# Per-request budget handed to every model client, in seconds (clamped to 5..300).
#
# The clients are also configured with max_retries=0, and that is load-bearing rather than
# tuning: the SDK's own retries are a SECOND retry authority underneath the router, and they
# turn one user request into three provider calls with the SDK's backoff in between. Measured
# on this machine before the change, a single Groq DMM call took 9.9s and then 24.0s; the
# router's own fallback for the same failure takes about 700ms. The router is the one
# authority, and this timeout is what bounds a provider that hangs instead of failing.
PROVIDER_TIMEOUT_SECONDS=30


# ==========================================
# ASSISTANT IDENTITY PROFILE
# ==========================================
ASSISTANT_NAME=KAYRA
# Options: Male / Female
ASSISTANT_GENDER=Female

# Language setting for systemic injection
LANGUAGE=English
USERNAME=Lucifer
# User Options: Male / Female
USER_GENDER=Male


# ------------------------------------------------------------------------------
# PROACTIVE SUGGESTION SERVICE (src/kayra/services/proactive_agent.py)
# ------------------------------------------------------------------------------
# The agent observes cheaply (clock + foreground window + counters), scores candidates with
# local arithmetic, and only speaks when a candidate clears the threshold AND every cooldown
# AND the assistant is genuinely idle. It never calls an LLM to decide whether to speak — at
# most once, to reword a suggestion it has already decided to make.
#
# Master switch. 'False' means the service is never started at all.
# It can also be turned off for the current session by voice: "stop proactive suggestions",
# "don't interrupt me", "disable proactive mode" (and back on with "enable proactive mode").
PROACTIVE_AGENT_ENABLED=True

# --- Observation cadence -------------------------------------------------------
# Seconds between cheap observation ticks. Measured cost of one tick: ~0.009ms, so the
# default is genuinely free; lower it only if you want faster reactions.
PROACTIVE_TICK_SECONDS=20
# Faster poll used ONLY while an approved suggestion is waiting for the user to go quiet.
PROACTIVE_DEFER_POLL_SECONDS=3

# --- Cooldowns (anti-spam) -----------------------------------------------------
# Minimum minutes between ANY two proactive suggestions.
PROACTIVE_GLOBAL_COOLDOWN_MINUTES=60
# Minimum minutes between two "take a break" suggestions specifically.
PROACTIVE_BREAK_COOLDOWN_MINUTES=90
# Minimum minutes before the EXACT same wording may be used again.
PROACTIVE_REPEAT_COOLDOWN_MINUTES=360
# How long after the user last spoke / was spoken to before an unprompted line is allowed.
PROACTIVE_QUIET_SECONDS=90
# An approved suggestion that never finds a safe moment within this many seconds is dropped
# rather than queued — a break reminder arriving forty minutes late is just noise.
PROACTIVE_MAX_DEFER_SECONDS=600

# --- Triggers ------------------------------------------------------------------
# Minutes of continuous focus on one application before a "take a break" nudge is considered.
PROACTIVE_FATIGUE_MINUTES=90
# Normalized relevance a candidate must reach to be spoken (0.0-1.0). Raising this makes the
# assistant quieter. Active-window context alone maxes out at 0.35 by design, so it can never
# trigger speech on its own regardless of this value.
PROACTIVE_SCORE_THRESHOLD=0.6
# Gentle wind-down nudge inside the late-night window (start inclusive, end exclusive).
PROACTIVE_LATE_NIGHT_ENABLED=True
PROACTIVE_LATE_NIGHT_START_HOUR=1
PROACTIVE_LATE_NIGHT_END_HOUR=5

# --- Habit model (data/habits.json) --------------------------------------------
# 'False' stops the agent recording anything at all; time and late-night triggers still work.
# Only action counters and 24-bucket hour histograms are stored — never what you said.
PROACTIVE_HABIT_LEARNING_ENABLED=True
# Hard caps on the habit file. The least-observed entries are evicted past these limits, so
# habits.json cannot grow without bound.
PROACTIVE_MAX_HABIT_ACTIONS=60
PROACTIVE_MAX_HABIT_APPS=40
# Observations required before a repeated action counts as a habit at all.
PROACTIVE_HABIT_MIN_COUNT=4
# Seconds between habit-file flushes.
PROACTIVE_SAVE_INTERVAL_SECONDS=300

# --- Wording -------------------------------------------------------------------
# 'True' lets the SHARED LLM engine reword an already-approved suggestion so it sounds less
# canned. Set 'False' to always use the built-in templates. Either way the agent works with
# no network and no cloud quota: a failed or malformed rewrite falls back to the template.
PROACTIVE_LLM_PHRASING=True


# ------------------------------------------------------------------------------
# PROACTIVE PRESENCE (src/kayra/intelligence/proactive_presence.py)
# ------------------------------------------------------------------------------
# The contextual layer ON TOP of the proactive service above. It supplies extra reasons to
# speak (a long working session, the small hours, sustained memory pressure, a repeatedly
# failing action, coming back to the desk) and the wording for them.
#
# It cannot make Kayra talk more often than the service above allows: the global cooldown,
# the safety gate and the single TTS pipeline are all unchanged, and everything except a
# CRITICAL observation still waits its turn behind PROACTIVE_GLOBAL_COOLDOWN_MINUTES.
#
# It calls NO model to decide whether to speak. Every gate below is integer arithmetic on
# values already in memory.

# Master switch for the contextual layer. With this off, the proactive service behaves
# exactly as it did before presence existed.
PROACTIVE_PRESENCE_ENABLED=True

# --- Categories ----------------------------------------------------------------
# Each is independently useful. All of them are also switchable live from Settings.
PROACTIVE_GREETINGS_ENABLED=True
PROACTIVE_CONTEXT_ENABLED=True
PROACTIVE_WORK_SESSION_ENABLED=True
PROACTIVE_SYSTEM_ENABLED=True
# One rare observational remark, hours apart. There is no joke engine behind this.
PROACTIVE_HUMOR_ENABLED=True
# (PROACTIVE_LATE_NIGHT_ENABLED above governs the late-night category too — one setting,
#  so the two layers can never disagree about whether late-night awareness is on.)

# --- Work sessions -------------------------------------------------------------
# Minutes of UNBROKEN interaction at which an observation becomes eligible. Each fires at
# most once per session, and they share a cooldown group with the break and late-night
# remarks so one long night cannot produce all three.
PROACTIVE_WORK_SESSION_MINUTES=45,90,150
# A silence longer than this ends the session, so the milestones start over. Someone who
# stepped out for lunch has not been "working for five hours".
PROACTIVE_SESSION_GAP_MINUTES=20

# --- Absence and return --------------------------------------------------------
# How a gap since the last exchange is described when you greet Kayra again.
PROACTIVE_SHORT_ABSENCE_MINUTES=12
PROACTIVE_LONG_ABSENCE_MINUTES=180
# How long the foreground window must be unreadable (locked screen, nothing focused) before
# coming back counts as returning to the machine.
PROACTIVE_AWAY_MINUTES=25

# --- System observations -------------------------------------------------------
# How often the cheap psutil sample is taken. This is three reads — it never walks the
# process tree and never opens a subprocess.
PROACTIVE_SYSTEM_SAMPLE_SECONDS=60
# A spike is not an anomaly: a reading must hold across this many consecutive samples.
PROACTIVE_PRESSURE_SAMPLES=3
PROACTIVE_RAM_WARN_PERCENT=90
PROACTIVE_RAM_CRITICAL_PERCENT=96
PROACTIVE_CPU_WARN_PERCENT=92
PROACTIVE_BATTERY_WARN_PERCENT=15

# --- Anticipation --------------------------------------------------------------
# How many failures of the SAME action, inside the window, before Kayra offers another
# approach — and how many repeats of the same request before it remarks on it.
PROACTIVE_REPEAT_FAILURE_COUNT=2
PROACTIVE_REPEAT_ACTION_COUNT=4
PROACTIVE_REPEAT_WINDOW_MINUTES=12

# --- Spacing -------------------------------------------------------------------
# Minimum gap between any two contextual remarks, and the hard ceiling for a whole day.
# The daily budget is the backstop: no combination of the settings above can exceed it.
PROACTIVE_PRESENCE_MIN_GAP_MINUTES=25
PROACTIVE_PRESENCE_DAILY_BUDGET=8
# Word-overlap similarity above which two remarks count as the same thing said twice.
PROACTIVE_SIMILARITY_THRESHOLD=0.6
# After the form of address is used, wordings that leave it out are preferred for this long,
# which is what keeps 'sir' out of every sentence.
PROACTIVE_ADDRESS_GAP_MINUTES=10

# --- Wording -------------------------------------------------------------------
# How Kayra addresses you. Defaults from USER_GENDER ('sir' / 'ma'am'); set it explicitly to
# use anything else.
# PROACTIVE_ADDRESS=sir
# 'True' lets the shared LLM reword an already-approved contextual remark. OFF by default:
# the templates are already short and specific, and a remark that waits on a cloud call is
# a worse remark. Warnings are never sent to the model regardless of this setting.
PROACTIVE_PRESENCE_LLM_PHRASING=False


# ------------------------------------------------------------------------------
# WINDOWS AUTOMATION (src/kayra/automation/windows.py + policy.py)
# ------------------------------------------------------------------------------
# These are BOUNDS, not behaviour switches. There is deliberately no setting that turns off
# the safety policy, the DENY list, or the confirmation prompt for destructive actions.

# How long a pending confirmation ("This will restart your computer. Should I go ahead?")
# stays answerable. After this it expires, so a forgotten prompt can never be triggered by an
# unrelated "sure" later in the conversation.
AUTOMATION_CONFIRM_TTL_SECONDS=60

# Hard timeout for a policy-approved terminal command, so an approved-but-hung command can
# never block the assistant indefinitely.
AUTOMATION_SHELL_TIMEOUT_SECONDS=20

# How many Kayra screenshots to keep on the Desktop. Older ones are deleted after each new
# capture; only files matching Kayra's own naming prefix are ever touched.
AUTOMATION_SCREENSHOT_KEEP=30

# Maximum simultaneously-armed timers. Bounded so a bad loop cannot create thousands.
AUTOMATION_MAX_TIMERS=16


# ------------------------------------------------------------------------------
# DEEP RESEARCH ENGINE TUNING (src/kayra/services/deep_research.py)
# ------------------------------------------------------------------------------
# How many distinct research angles the planning stage decomposes a topic into.
MAX_SUB_QUESTIONS=5
# How many gap-filling follow-up queries the analysis stage generates.
MAX_FOLLOWUP_QUERIES=3
# How many full pages get deep-scraped (beyond snippet-level) per research pass.
MAX_DEEP_PAGES=4
# How many search results are pulled per individual query.
SEARCH_RESULTS_PER_QUERY=6


# ==============================================================================
# TERMINAL LOGGING (src/kayra/core/logbus.py)
# ==============================================================================
# Kayra's own log lines all have one shape:
#
#     [21:48:03] [INFO   ] [STT] Backend: Google Chrome
#
# a timestamp, a level, a canonical subsystem tag, and the message. The subsystem names are
# fixed (BOOT, STT, VOICE, DMM, LLM, CHAT, SEARCH, RESEARCH, AUTO, TTS, PROACTIVE, PRESENCE,
# MEMORY, SETTINGS, UI, GPU, SYSTEM, SHUTDOWN) and each event has exactly ONE owner, so the
# same thing is never reported twice by two layers.

# Console threshold: DEBUG | INFO | WARNING | ERROR. Default INFO.
#
# INFO is the normal path — what started, which backend, which provider answered, what the
# user said, what was done, whether it worked. DEBUG adds the internals: interim transcripts,
# VAD levels, provider exception text, presence scores, dropped stale UI revisions, and the
# tracebacks of expected recoverable failures. Nothing is hidden at INFO — it is moved, not
# discarded — so raising this is how you diagnose something, not how you find out what broke.
#
# Read from the PROCESS environment first and this file second, so `set KAYRA_LOG_LEVEL=DEBUG`
# applies to one run without editing anything.
KAYRA_LOG_LEVEL=INFO

# Write the full DEBUG stream to logs/kayra-debug.log as well as the console. Off by default.
# The file rotates at 2 MB and keeps 3 of them: Kayra is meant to run all day, and an unbounded
# diagnostic log on a process like that is a slow disk-filling bug. Secrets are redacted in the
# file exactly as they are on the console.
KAYRA_LOG_FILE=False


# ==============================================================================
# HAND GESTURE CONTROL (src/kayra/input/gesture/)
# ==============================================================================
# Camera in, mouse pointer out. Your index finger moves the cursor, index+thumb is a left
# click, middle+thumb is a right click, index+middle+thumb together is a double click, two
# fingers swept up or down scrolls, and a closed fist pauses everything until you open it.
#
# TWO SWITCHES, NOT ONE. The camera and gesture control are separate, because seeing the
# preview and having something move your pointer are different requests:
#
#     camera ON,  gesture OFF   the Home preview works, nothing touches the pointer
#     camera ON,  gesture ON    the feature, running
#     camera OFF, gesture OFF   nothing running, the device released
#
# Turning gesture control on with the camera off starts the camera first; turning the camera
# off turns gesture control off with it. Both switches are LIVE - they act on the running
# controller immediately, and are reflected back from it, so a camera that fails to open
# leaves the switch off rather than showing what was asked for.
#
# You can also say: "turn on hand gesture control" / "turn off hand gesture control" /
# "turn on the camera" / "turn off the camera". Those are matched locally, before the
# classifier, so they work with the network down and cost no round-trip.
#
# EVERY GEOMETRIC THRESHOLD BELOW IS A RATIO OF HAND SIZE, NEVER A PIXEL COUNT. A pixel
# threshold changes meaning when you move: at arm's length a 30px pinch gate is a third of the
# whole hand and every closed finger reads as a click, while leaning in, a real pinch never
# gets under 30px and clicking stops working. Both were real symptoms of the previous engine.

# Start hand gesture control with Kayra. OFF by default and deliberately so: something that
# moves your mouse pointer should be something you asked for, not something you discover.
GESTURE_ENABLED=False

# Start the camera (preview only) with Kayra, without gesture control. Also off by default.
GESTURE_CAMERA_AUTOSTART=False

# -- The camera --
# 640x480 at 30 FPS is the right size, not a compromise: hand landmarks are regressed from a
# small crop, so a larger frame costs colour conversion and memory bandwidth for no accuracy.
GESTURE_CAMERA_INDEX=0
GESTURE_CAMERA_WIDTH=640
GESTURE_CAMERA_HEIGHT=480
GESTURE_TARGET_FPS=30

# Which OpenCV capture backend to use: AUTO | MSMF | DSHOW.
#
# AUTO, and that default is a correction. This module originally hardcoded DSHOW on the
# strength of a performance claim that had never been measured. Measured properly, on this
# machine, eight open/close cycles in a clean process each:
#
#     CAP_DSHOW   17.2 threads leaked per cycle   1655 ms to open
#     CAP_MSMF     2.0                             529 ms
#     CAP_ANY      2.0                             516 ms
#
# DSHOW was three times slower AND leaked eight times as many threads: toggling the camera
# twenty times from Home took the process from 5 threads and 25 MB to 334 threads and 237 MB.
# On AUTO the same twenty toggles leave the thread count flat. Capture-backend behaviour is
# machine-specific, so this stays configurable - but change it only with a measurement.
GESTURE_CAMERA_BACKEND=AUTO

# Mirror the image, so moving your hand right moves the pointer right. Leave this on unless
# your camera already mirrors in hardware.
GESTURE_CAMERA_MIRROR=True

# The Home preview's refresh rate, deliberately BELOW the processing rate. The preview is a
# reassurance, not an instrument, and repainting it 30 times a second spends GUI-thread budget
# on images nobody looks at between frames.
GESTURE_PREVIEW_FPS=15

# -- The detector --
# Complexity 0 is MediaPipe's LITE hand graph: 9-12ms per frame here, against 26-31ms for
# complexity 1. On a 33ms budget the full graph leaves nothing, and a loop with no slack falls
# behind the camera on the first hiccup and never catches up - that was the freeze. Set this to
# 1 only if you have measured that your machine can afford it.
GESTURE_MODEL_COMPLEXITY=0
GESTURE_DETECTION_CONFIDENCE=0.6
GESTURE_TRACKING_CONFIDENCE=0.5

# AUTO | ON | OFF. AUTO probes once for a usable GPU delegate and stays on the processor when
# there is none, which on Windows is always: MediaPipe's pip wheel builds `solutions.hands`
# CPU-only. That is the right answer anyway here - inference is not the bottleneck, and a
# second CUDA context would contend with the ONNX Runtime session Kokoro speech already holds.
# ON forces the probe and says so loudly when it fails; OFF never probes.
GESTURE_GPU=AUTO

# -- The three dials --
# LOW | MEDIUM | HIGH each. These are the settings worth changing; everything below them is a
# threshold you should not need to touch.

# How readily a pose is recognised: the confirmation time, the stability floor and the
# confidence floor. LOW means you have to mean it.
GESTURE_SENSITIVITY=MEDIUM

# Stable when still versus responsive when moving. HIGHER IS NOT SLOWER - the filter smooths
# harder at rest AND releases harder under motion, so raising this does not add lag to
# deliberate movement. Measured at MEDIUM: 8.3px of stationary jitter reduced to 3.5px, with
# 39ms of lag on a slow move and 16ms on a fast one.
GESTURE_CURSOR_SMOOTHING=MEDIUM

# How closed a pinch has to be, and how long it has to hold.
GESTURE_CLICK_SENSITIVITY=MEDIUM

# -- Cursor stabilisation --
# One Euro filter parameters, overriding the smoothing preset above. `min_cutoff` is how hard
# a STATIONARY hand is smoothed; `beta` is how fast that smoothing is released as the hand
# speeds up. Beta is in the TENS here, not the hundredths: the filter runs on normalized frame
# coordinates, where a fast flick is ~0.6 units/s, so a beta of 0.05 contributes nothing and
# leaves you with a fixed low-pass - which is exactly why the old cursor felt laggy despite
# carrying an adaptive filter.
GESTURE_CURSOR_MIN_CUTOFF=1.0
GESTURE_CURSOR_BETA=12.0

# Pointer movement below this many pixels is not emitted AT ALL. A filter converges towards a
# noisy mean; it does not stop. The dead-zone is what makes a still hand produce a still
# pointer, and it also means a resting hand costs zero input events.
GESTURE_CURSOR_DEADZONE=2.0

# The pointer may never travel faster than this, in pixels per second. The last backstop
# against a landmark glitch crossing the screen in one frame.
GESTURE_CURSOR_MAX_SPEED=6000

# A landmark sample that implies the hand moved faster than this many HAND WIDTHS per second
# is discarded as a regression glitch. In hand widths rather than pixels so it means the same
# thing at every distance. A real hand covers 6-10; the default sits above deliberate movement
# and far below a glitch. After three consecutive rejections the sample is accepted as a jump
# and the filters re-seed, so a hand that genuinely IS somewhere else is still reachable.
GESTURE_OUTLIER_SCALES=14.0

# -- Cursor mapping --
# The usable region of the camera frame, as fractions of each edge. Asymmetric at the bottom
# because your forearm enters from below: a symmetric box clips the wrist, and the hand scale
# every threshold depends on collapses just as you reach the bottom of the screen.
GESTURE_REGION_X=0.16
GESTURE_REGION_TOP=0.14
GESTURE_REGION_BOTTOM=0.34

# -- The pause gesture --
# A closed fist pauses gesture control until you open your hand again. It is the ONLY gesture
# that can pause it, and "no hand in frame" is emphatically not a pause - that is gesture
# control running normally with nothing to act on.
#
# THESE THRESHOLDS EXIST BECAUSE THE FIRST VERSION HAD NONE. It tested "is every finger curled"
# once per frame, with no hold time and no hysteresis. A real pointing finger is not perfectly
# straight, its measured extension sits close to that comparator, and landmark noise carried it
# back and forth across it several times a second: measured at 206 ACTIVE-to-PAUSED-to-ACTIVE
# round trips in 600 frames of an ordinary cursor session. With a slightly more relaxed finger
# the system was paused 78% of the time.

# Whether the fist gesture pauses at all. Set to False if you would rather use only the
# Home toggle and the voice commands.
GESTURE_PAUSE_ENABLED=True

# How closed the hand must be, as 1 minus the extension of the MOST EXTENDED finger. 0.82 means
# even your straightest finger is under 18% extended - a real fist, and nowhere near any
# resting pose. The release threshold is separate and lower, which is the hysteresis.
GESTURE_PAUSE_THRESHOLD=0.82
GESTURE_PAUSE_RELEASE_THRESHOLD=0.55

# How long the fist must be HELD before it pauses. This is what makes the pause deliberate
# rather than something noise can do to you.
GESTURE_PAUSE_HOLD_MS=500

# How long your hand must be CONTINUOUSLY open before control resumes. The timer restarts if
# your hand closes again, so opening it for a frame or two does not resume control you
# deliberately stopped.
GESTURE_RESUME_HOLD_MS=300

# -- Gesture gating --
# How long a pose must persist before it counts, and how trustworthy the frame must be for an
# action to fire. Stability gates CLICKS AND SCROLL, never cursor movement: a stuttering
# pointer during noisy tracking is an annoyance, a click fired during noisy tracking lands on
# whatever happens to be underneath it.
GESTURE_CONFIRM_MS=120
GESTURE_MIN_STABILITY=0.50
GESTURE_MIN_CONFIDENCE=0.62

# Losing the hand for a frame or two must not cancel a drag or reset a scroll, so the state is
# HELD for this long - while producing no action, so a dropout can never itself cause a click.
# Past it everything is dropped and the next hand is a fresh acquisition.
GESTURE_HAND_LOST_GRACE_MS=220
GESTURE_REACQUIRE_MS=180

# -- Clicks --
# Fingertip separation divided by hand size. The RELEASE threshold must exceed the press
# threshold - that gap is the hysteresis, and without it the gate chatters on noise. A value
# that inverts them is corrected at startup and the correction is logged.
GESTURE_CLICK_THRESHOLD=0.34
GESTURE_CLICK_RELEASE_THRESHOLD=0.46
GESTURE_CLICK_HOLD_MS=80

# The minimum gap between two clicks. Long enough that one pinch is one click, short enough
# that deliberate repeated clicking still works.
GESTURE_CLICK_COOLDOWN_MS=320

# How long a pinch must be HELD before the pointer follows your hand again.
#
# THIS IS WHY CLICKS LAND WHERE YOU AIMED. Pinching curls your index finger towards your
# thumb, and the index tip is the landmark driving the cursor - so the act of clicking drags
# the pointer by about half a hand-width unless it is frozen first. It is frozen from the
# moment the pinch starts closing until this threshold, after which you are evidently dragging
# and the pointer follows. Set it to 0 to disable the freeze entirely.
GESTURE_DRAG_UNLOCK_MS=260

# -- Scroll --
# Vertical velocity of the two-finger pair, in hand widths per second. VELOCITY, not distance
# from an anchor: an anchor keeps scrolling forever while your hand is held still away from
# it, which is why scrolling used to be hard to stop. A still hand scrolls by nothing.
GESTURE_SCROLL_THRESHOLD=0.55

# The NEUTRAL threshold. A direction, once engaged, holds until the velocity falls back below
# this - so one noisy frame in the opposite sense cannot reverse the scroll. That gap is what
# stops the up/down/up/down chatter.
GESTURE_SCROLL_HYSTERESIS=0.22

# How long the two-finger pose must be held before it counts as a scroll pose at all.
GESTURE_SCROLL_POSE_MS=130

# Wheel notches per unit of velocity, the ceiling on any single impulse, and the minimum gap
# between impulses. The cap is what stops one fast sweep throwing a page across a document.
GESTURE_SCROLL_GAIN=220
GESTURE_SCROLL_MAX_IMPULSE=360
GESTURE_SCROLL_INTERVAL_MS=45

# Frame rates, inference latency, hand stability, gesture confidence, cursor velocity and
# dropped-frame counts, at DEBUG level. Off by default: this is per-second diagnostic output,
# and it is the first thing to turn on if gestures feel wrong.
GESTURE_DIAGNOSTICS=False
