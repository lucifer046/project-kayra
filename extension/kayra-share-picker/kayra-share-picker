#!/usr/bin/env python3
# ┌────────────────────────────────────────────────────────────────────────┐
# │                         kayra-share-picker                             │
# │   xdg-desktop-portal-hyprland's screen-share picker, with a Kayra lane │
# └────────────────────────────────────────────────────────────────────────┘
"""
Set as `screencopy:custom_picker_binary` in ~/.config/hypr/xdph.conf (setup.py offers it;
`python -m kayra.automation.share_picker install|uninstall|status`).

When an app asks to share the screen, the portal runs this program and reads ONE line from it:

    [SELECTION]/window:<handle>        a window, by the handle the portal listed
    [SELECTION]/screen:<monitor name>  a whole monitor

THE KAYRA LANE. When the user says "share the LM Studio window", Kayra writes a one-shot
request file ($XDG_RUNTIME_DIR/kayra/share-request.json) just before it presses Meet's share
button. This program reads it, DELETES it (it is answered once, never twice), finds the window
in the list the portal passed in XDPH_WINDOW_SHARING_LIST, and prints the selection.

EVERY OTHER CASE is the normal picker, unchanged: no request, a stale request (older than
REQUEST_TTL_S), a window that is not in the list, a malformed file. The normal picker is the
one that was configured before Kayra's (recorded by `install`), else
hyprland-preview-share-picker, else hyprland-share-picker. Manual sharing never changes.

Stdlib only, no Kayra import: the portal runs it with the system Python, outside the venv.
The tests load it as a module (`select`, `parse_sharing_list` are pure).
"""

import os
import sys
import json
import time
import shutil

REQUEST_TTL_S = 30.0
PICKERS = ("hyprland-preview-share-picker", "hyprland-share-picker")


def runtime_dir(environ=None):
    environ = os.environ if environ is None else environ
    base = environ.get("XDG_RUNTIME_DIR") or os.path.join("/tmp", f"kayra-{os.getuid()}")
    return os.path.join(base, "kayra")


def request_path(environ=None):
    return os.path.join(runtime_dir(environ), "share-request.json")


def fallback_record(environ=None):
    environ = os.environ if environ is None else environ
    config = environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config, "kayra", "share-picker-fallback")


def parse_sharing_list(raw):
    """
    XDPH_WINDOW_SHARING_LIST -> [{"handle", "class", "title", "address"}].

    Entries are `<handle>[HC>]<class>[HT>]<title>[HE>]<window address>[HA>]`. Older portals
    leave out the address field; such entries carry address None.
    """
    windows = []
    for entry in str(raw or "").split("[HA>]"):
        if "[HC>]" not in entry:
            continue
        handle, rest = entry.split("[HC>]", 1)
        cls, rest = rest.split("[HT>]", 1) if "[HT>]" in rest else (rest, "")
        title, address = rest.split("[HE>]", 1) if "[HE>]" in rest else (rest, "")
        windows.append({"handle": handle.strip(), "class": cls, "title": title,
                        "address": _as_int(address)})
    return windows


def _as_int(text):
    text = str(text or "").strip().lower()
    if not text:
        return None
    try:
        return int(text, 16) if text.startswith("0x") else int(text)
    except ValueError:
        return None


def select(request, windows, now=None):
    """
    The selection line for a request, or None (= run the normal picker).

    A window is matched by its Hyprland address first (exact identity), then by class AND
    title, then by a class or a title that only ONE listed window has. Never a guess between
    two windows: sharing the wrong one is worse than showing the picker.
    """
    if not isinstance(request, dict):
        return None
    now = time.time() if now is None else now
    created = request.get("created")
    if not isinstance(created, (int, float)) or not (0 <= now - created <= REQUEST_TTL_S):
        return None
    kind = request.get("kind")
    if kind == "monitor":
        name = str(request.get("name") or "").strip()
        return f"[SELECTION]/screen:{name}" if name and "\n" not in name else None
    if kind != "window":
        return None
    address = _as_int(request.get("address"))
    if address is not None:
        hits = [w for w in windows if w["address"] == address]
        if len(hits) == 1:
            return f"[SELECTION]/window:{hits[0]['handle']}"
    cls = str(request.get("class") or "").lower()
    title = str(request.get("title") or "")
    hits = [w for w in windows if cls and w["class"].lower() == cls and title and w["title"] == title]
    if len(hits) != 1:
        hits = [w for w in windows if cls and w["class"].lower() == cls]
    if len(hits) != 1:
        hits = [w for w in windows if title and w["title"] == title]
    if len(hits) == 1 and hits[0]["handle"].isdigit():
        return f"[SELECTION]/window:{hits[0]['handle']}"
    return None


def take_request(path=None):
    """Reads and deletes the request file. Answered once, even when it cannot be used."""
    path = path or request_path()
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        data = None
    try:
        os.remove(path)
    except OSError:
        pass
    return data


def normal_picker(environ=None):
    """argv of the picker that was there before Kayra's, never this program itself."""
    me = os.path.realpath(__file__)
    try:
        with open(fallback_record(environ), "r", encoding="utf-8") as handle:
            recorded = handle.read().strip().split()
    except OSError:
        recorded = []
    if recorded:
        found = shutil.which(recorded[0]) or recorded[0]
        if os.path.exists(found) and os.path.realpath(found) != me:
            return [found] + recorded[1:]
    for name in PICKERS:
        found = shutil.which(name)
        if found and os.path.realpath(found) != me:
            return [found]
    return None


def main(argv):
    line = select(take_request(), parse_sharing_list(os.environ.get("XDPH_WINDOW_SHARING_LIST")))
    if line:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
        return 0
    picker = normal_picker()
    if picker is None:
        sys.stderr.write("kayra-share-picker: no normal share picker is installed\n")
        return 1
    os.execv(picker[0], picker + list(argv[1:]))
    return 1                                    # not reached


if __name__ == "__main__":
    sys.exit(main(sys.argv))
