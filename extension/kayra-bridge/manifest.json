{
  "manifest_version": 3,
  "name": "Kayra Bridge",
  "version": "1.15.0",
  "description": "Lets the Kayra desktop assistant on this computer control Chrome by voice: tabs, clicks, typing, reading pages, Google Meet.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "history",
    "bookmarks",
    "sessions",
    "alarms",
    "storage",
    "tabGroups",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Kayra Bridge"
  }
}
